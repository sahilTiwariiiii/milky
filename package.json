{
  "name": "customer-qr-milk-management",
  "version": "1.0.0",
  "description": "Customer QR & Milk/Product Management Backend System with Node.js, Express, and MongoDB",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev:backend": "nodemon src/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "seed": "node src/seeds/seed.js",
    "test": "jest --runInBand --forceExit"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "qr-code",
    "milk-management",
    "dairy",
    "react",
    "vite"
  ],
  "author": "Antigravity Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.1",
    "multer": "^2.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.0"
  }
}
